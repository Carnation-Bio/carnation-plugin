{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "carnation",
  "version": "0.1.0-beta.3",
  "description": "Author and validate microscopy analysis pipelines with Carnation.",
  "author": {
    "name": "Carnation Bio",
    "email": "support@carnation.bio",
    "url": "https://carnation.bio"
  },
  "homepage": "https://carnation.bio",
  "repository": "https://github.com/Carnation-Bio/carnation-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "microscopy",
    "image-analysis",
    "biology"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Carnation",
        "shortDescription": "Build and validate microscopy pipelines.",
        "longDescription": "Inspect microscopy data, build analysis pipelines, preview results, compare parameters, and save validated pipelines in Carnation.",
        "developerName": "Carnation Bio",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://carnation.bio",
        "defaultPrompt": [
          "Use this paper to build a matching analysis pipeline for my dataset. Test it on representative fields and show me the evidence."
        ],
        "brandColor": "#D94A64",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo-dark.svg",
        "screenshots": [
          "./assets/carnation-analysis.png"
        ]
      }
    }
  }
}
